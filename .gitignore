# Local environment files in either app

.env
.env.*
!.env.production.example
!.env.example

# Rails credentials and sensitive files

/backend/config/master.key
/backend/config/credentials/*.key

# Rails logs, temp files, and local SQLite Storage

/backend/log/*
!/backend/log/.keep
/backend/tmp/*
!/backend/tmp/.keep
/backend/storage/*
!/backend/storage/
.keepbackend/log/*.log

# Rails local environment variables
/backend/.env
/backend/.env.*
